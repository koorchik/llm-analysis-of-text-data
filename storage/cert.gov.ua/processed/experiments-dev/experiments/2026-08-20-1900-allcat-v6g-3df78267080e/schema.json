        "rungs": [
          {
            "g": 0,
            "alias": "product_name",
            "example": "Microsoft Office 2016",
            "disputed": false
          },
          {
            "g": 1,
            "alias": "software_suite",
            "example": "Office 2016",
            "disputed": false,
            "move": "drop-qualifier",
            "preserving": true,
            "foldTest": "'Microsoft Office 2016 was involved in an event' -> 'Office 2016 was involved in an event': same claim, less detail",
            "edgeKind": "coarsens-to"
          }
        ],
        "rejected": [
          {
            "candidate": "Office",
            "gate": "3",
            "reason": "Dropping '2016' removes a digit/version identifier. The rule states identity-bearing digits must not be dropped."
          },
          {
            "candidate": "Word",
            "gate": "2",
            "reason": "Moving from 'Microsoft Word' to 'Word' is valid, but the next logical step (e.g., to 'Application') would exit the category or change the referent."
          },
          {
            "candidate": "Excel",
            "gate": "2",
            "reason": "A move from a specific file like 'PGMB New Order 18-2077.xlsx' to 'Excel' changes the referent from an instance/file to the containing application software."
          }
        ],
        "notes": "The ladder identifies products with brand qualifiers (e.g., 'Microsoft') as the primary point of coarsening. Moving beyond the version number (2016) is avoided to comply with the hard rule against dropping identity-bearing digits.",
        "disagreements": [],
        "discoveredAtDoc": 40102
      }
