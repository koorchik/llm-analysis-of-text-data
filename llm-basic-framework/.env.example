# Copy to .env and fill in. NEVER commit .env — it is gitignored on purpose.
# Only the provider you actually run needs a real key.

# --- cloud providers -------------------------------------------------------
ANTHROPIC_API_KEY="CHANGE_ME"
OPENAI_API_KEY="CHANGE_ME"
GEMINI_API_KEY="CHANGE_ME"

# Google Vertex AI (distinct from GEMINI_API_KEY — needs a GCP project)
VERTEXAI_PROJECT="CHANGE_ME"
VERTEXAI_LOCATION="us-central1"
GOOGLE_APPLICATION_CREDENTIALS="CHANGE_ME"

# Only needed for ollama.com-hosted models (e.g. gpt-oss). A LOCAL ollama
# server needs no key at all.
OLLAMA_API_KEY="CHANGE_ME"

# --- defaults for interactive use ------------------------------------------
# CLI env vars override these, and every experiment arm sets them explicitly,
# so treat these as convenience only — never as the definition of an arm.
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-opus-5"
FLOW="incremental"
STEPS="streamingPipeline"

# Embeddings are OFF unless EMBEDDINGS=1. Required by CANDIDATE_GENERATOR=union,
# which fails fast without a working config rather than downgrading silently.
# bge-m3 via ollama is a strong multilingual option and runs locally for free.
EMBEDDINGS_PROVIDER="openai"
EMBEDDINGS_MODEL="text-embedding-3-large"
